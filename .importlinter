[importlinter]
root_package = custom_components.gtfs2
# the rule is about the code that runs: a type named for the annotations
# only, under TYPE_CHECKING, may come from any layer (ARCHITECTURE.md)
exclude_type_checking_imports = True

# The dependency rule of ARCHITECTURE.md: a module imports from its own
# layer, from a lower one and from the modules outside the layers, never
# from a higher layer.
[importlinter:contract:layers]
name = A module never imports from a higher layer
type = layers
containers =
    custom_components.gtfs2
layers =
    coordinator : sensor : update : button : switch : datasource_services : departure_services : repairs
    config_flow : flow_source : flow_reload : flow_journey : flow_train : flow_options
    alerts : departure_attributes : refresh_steps : route_names : stations : exports : local_stops : gtfs_rt_helper
    gtfs_db : gtfs_filter : direction_repair : gtfs_shape : geojson : leg : timetable : feed_window : places : place_order : destination_order : pair_direction : gtfs_helper : source_zip : source_refresh : rt_window
    rt_source : zip_peek : freshness : rt_feed

[importlinter:contract:acyclic]
name = No import cycle between the component's modules
type = acyclic_siblings
ancestors =
    custom_components.gtfs2
