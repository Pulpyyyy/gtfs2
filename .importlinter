[importlinter]
root_package = custom_components.gtfs2
# the rule is about the code that runs: a type named for the annotations
# only, under TYPE_CHECKING, may come from any layer (ARCHITECTURE.md)
exclude_type_checking_imports = True

# The dependency rule of ARCHITECTURE.md: a module imports from its own
# layer, from a lower one and from the modules outside the layers, never
# from a higher layer.
[importlinter:contract:layers]
name = A module never imports from a higher layer
type = layers
containers =
    custom_components.gtfs2
layers =
    coordinator : sensor : update : button : switch : source_services : departure_services : repairs
    config_flow : flow
    domain
    data
    feed

[importlinter:contract:acyclic]
name = No import cycle between the component's modules
type = acyclic_siblings
ancestors =
    custom_components.gtfs2
    custom_components.gtfs2.feed
    custom_components.gtfs2.data
    custom_components.gtfs2.domain
    custom_components.gtfs2.flow
